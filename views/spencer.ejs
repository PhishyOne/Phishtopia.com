<%- include('partials/header') %>

<main class="spencer-shell">
    <div class="spencer-orbit spencer-orbit-one" aria-hidden="true"></div>
    <div class="spencer-orbit spencer-orbit-two" aria-hidden="true"></div>

    <section class="spencer-card" aria-labelledby="spencer-title">
        <p class="spencer-signal">
            <span class="signal-dot" aria-hidden="true"></span>
            Private transmission // Phishtopia
        </p>

        <div class="spencer-logo-wrap" aria-hidden="true">
            <img src="/images/phishLogo.png" alt="" class="spencer-logo">
            <span class="logo-ring logo-ring-one"></span>
            <span class="logo-ring logo-ring-two"></span>
        </div>

        <h1 id="spencer-title">
            Hey, Spencer.
            <span>This one is for you.</span>
        </h1>

        <p class="spencer-intro">
            I am trying to show off what this thing can do, man.
        </p>

        <div class="spencer-terminal" aria-label="Message status">
            <div class="terminal-bar">
                <span class="terminal-light"></span>
                <span class="terminal-light"></span>
                <span class="terminal-light"></span>
                <span class="terminal-title">message_from_phish.exe</span>
            </div>

            <div class="terminal-body">
                <p><span>&gt;</span> establishing connection...</p>
                <p><span>&gt;</span> recipient: SPENCER</p>
                <p><span>&gt;</span> friendship protocol: ACTIVE</p>
                <p><span>&gt;</span> improbable systems: ONLINE</p>
                <p class="terminal-success"><span>&gt;</span> transmission received.</p>
            </div>
        </div>

        <p class="spencer-closing">
            Welcome to Phishtopia, buddy. Home of the improbable.
        </p>

        <a class="spencer-button" href="/">
            Enter Phishtopia
            <span aria-hidden="true">→</span>
        </a>
    </section>
</main>

<%- include('partials/footer') %>
