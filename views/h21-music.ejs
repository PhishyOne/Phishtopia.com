<%- include('partials/header') %>

<main class="h21-music-shell">
    <section class="h21-music-card" aria-labelledby="h21-music-title">
        <p class="h21-kicker">PROJECT H21 // MUSIC CONCEPT 01</p>

        <div class="h21-title-block">
            <p class="h21-status"><span aria-hidden="true"></span> Working title-screen / login theme</p>
            <h1 id="h21-music-title">Echoes of the Archipelago</h1>
            <p class="h21-subtitle">A first musical direction for entering a dangerous, persistent island world.</p>
        </div>

        <div class="h21-player-frame">
            <iframe
                src="https://suno.com/embed/d5e39f7e-bf74-4580-a384-ad7087fb2f03"
                title="Echoes of the Archipelago — Project H21 music concept"
                loading="eager"
                allow="autoplay; encrypted-media"
            ></iframe>
        </div>

        <div class="h21-details" aria-label="Music concept notes">
            <div>
                <span>Intent</span>
                <strong>Tension · danger · anticipation</strong>
            </div>
            <div>
                <span>Palette</span>
                <strong>Martial snares · low percussion · distant voices</strong>
            </div>
            <div>
                <span>Length</span>
                <strong>2:05</strong>
            </div>
        </div>

        <p class="h21-note">
            This is an early concept, not final game audio. The goal is to establish the feeling a player gets while registering, logging in, and crossing into H21 for the first time.
        </p>

        <a class="h21-suno-link" href="https://suno.com/song/d5e39f7e-bf74-4580-a384-ad7087fb2f03" target="_blank" rel="noopener noreferrer">
            Open track in Suno <span aria-hidden="true">↗</span>
        </a>
    </section>
</main>

<%- include('partials/footer') %>
