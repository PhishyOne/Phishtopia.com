<%- include('../partials/header') %>

<main class="account-page">
    <section class="account-hero" aria-labelledby="account-heading">
        <div>
            <p class="account-eyebrow">Phishtopia account</p>
            <h1 id="account-heading">Manage your account</h1>
            <p>Update your sign-in information without exposing it to other users.</p>
        </div>

        <dl class="account-summary">
            <div>
                <dt>Username</dt>
                <dd><%= account.username %></dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd><%= account.email %></dd>
            </div>
            <div>
                <dt>Email status</dt>
                <dd><%= account.emailVerified ? 'Verified' : 'Not verified' %></dd>
            </div>
            <% if (account.role === 'admin') { %>
                <div>
                    <dt>Access</dt>
                    <dd>Administrator</dd>
                </div>
            <% } %>
        </dl>
    </section>

    <% if (notice) { %>
        <div class="account-alert account-alert-success" role="status"><%= notice %></div>
    <% } %>

    <% if (error) { %>
        <div class="account-alert account-alert-error" role="alert"><%= error %></div>
    <% } %>

    <% if (account.pendingEmail) { %>
        <div class="account-alert account-alert-pending" role="status">
            Waiting for confirmation from <strong><%= account.pendingEmail %></strong>. Requesting another address below will replace this pending change.
        </div>
    <% } %>

    <section class="account-grid" aria-label="Account settings">
        <article class="account-card <%= section === 'username' ? 'account-card-active' : '' %>">
            <div class="account-card-heading">
                <h2>Username</h2>
                <p>This is the name shown when you contribute publicly.</p>
            </div>

            <form action="/account/username" method="POST" class="account-form">
                <label for="account-username">New username</label>
                <input
                    id="account-username"
                    name="username"
                    type="text"
                    autocomplete="username"
                    minlength="3"
                    maxlength="50"
                    value="<%= values.username || account.username %>"
                    required
                >

                <label for="username-current-password">Current password</label>
                <div class="account-password-field">
                    <input
                        id="username-current-password"
                        name="currentPassword"
                        type="password"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        type="button"
                        class="account-password-toggle"
                        data-password-toggle="username-current-password"
                        aria-label="Show password"
                        aria-pressed="false"
                    >👁</button>
                </div>

                <button type="submit" class="account-submit">Update username</button>
            </form>
        </article>

        <article class="account-card <%= section === 'email' ? 'account-card-active' : '' %>">
            <div class="account-card-heading">
                <h2>Email address</h2>
                <p>Your current email stays active until the new one is confirmed.</p>
            </div>

            <form action="/account/email" method="POST" class="account-form">
                <label for="account-email">New email</label>
                <input
                    id="account-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    value="<%= values.email || account.pendingEmail || account.email %>"
                    required
                >

                <label for="email-current-password">Current password</label>
                <div class="account-password-field">
                    <input
                        id="email-current-password"
                        name="currentPassword"
                        type="password"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        type="button"
                        class="account-password-toggle"
                        data-password-toggle="email-current-password"
                        aria-label="Show password"
                        aria-pressed="false"
                    >👁</button>
                </div>

                <button type="submit" class="account-submit">Send verification link</button>
            </form>
        </article>

        <article class="account-card account-card-wide <%= section === 'password' ? 'account-card-active' : '' %>">
            <div class="account-card-heading">
                <h2>Password</h2>
                <p>Changing your password closes your other signed-in sessions.</p>
            </div>

            <form action="/account/password" method="POST" class="account-form account-password-form">
                <div>
                    <label for="password-current">Current password</label>
                    <div class="account-password-field">
                        <input
                            id="password-current"
                            name="currentPassword"
                            type="password"
                            autocomplete="current-password"
                            required
                        >
                        <button
                            type="button"
                            class="account-password-toggle"
                            data-password-toggle="password-current"
                            aria-label="Show password"
                            aria-pressed="false"
                        >👁</button>
                    </div>
                </div>

                <div>
                    <label for="password-new">New password</label>
                    <div class="account-password-field">
                        <input
                            id="password-new"
                            name="newPassword"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="128"
                            required
                        >
                        <button
                            type="button"
                            class="account-password-toggle"
                            data-password-toggle="password-new"
                            aria-label="Show password"
                            aria-pressed="false"
                        >👁</button>
                    </div>
                </div>

                <div>
                    <label for="password-confirm">Confirm new password</label>
                    <div class="account-password-field">
                        <input
                            id="password-confirm"
                            name="confirmPassword"
                            type="password"
                            autocomplete="new-password"
                            minlength="8"
                            maxlength="128"
                            required
                        >
                        <button
                            type="button"
                            class="account-password-toggle"
                            data-password-toggle="password-confirm"
                            aria-label="Show password"
                            aria-pressed="false"
                        >👁</button>
                    </div>
                </div>

                <button type="submit" class="account-submit">Change password</button>
            </form>
        </article>
    </section>
</main>

<%- include('../partials/footer') %>
