<!DOCTYPE html>
<html lang="en">

<head>
    <% const analyticsDisabled = typeof disableAnalytics !== 'undefined' && disableAnalytics; %>
    <% const robots = typeof robotsContent !== 'undefined' ? robotsContent : 'index, follow'; %>
    <% const sharePages = {
        'home-page': {
            title: 'Phishtopia | Home of the Improbable',
            description: 'Explore practical web tools, unusual experiments, and whatever Phishtopia builds next.',
            image: 'https://phishtopia.com/share/home.png',
            imageType: 'image/png',
            imageAlt: 'An underwater technology scene with a glowing fish and the words Home of the Improbable.'
        },
        'youlist': {
            title: 'YouList | Build Your Watchlist',
            description: 'Find movies and shows, save a personal watchlist, and add your own notes with YouList.',
            image: 'https://phishtopia.com/share/youlist.png',
            imageType: 'image/png',
            imageAlt: 'A cinematic watchlist interface with movie cards and the words Build your watchlist.'
        },
        'player-int': {
            title: 'EchoTrace | EVE Echoes Player Intelligence',
            description: 'Explore public EVE Echoes character signals and connections with EchoTrace.',
            image: 'https://phishtopia.com/share/echotrace.png',
            imageType: 'image/png',
            imageAlt: 'A futuristic radar display and connected star map for EVE Echoes player intelligence.'
        },
        'storecalc': {
            title: 'StoreCalc Online | Commissary Order Calculator',
            description: 'Calculate commissary totals and organize an order before it is placed with StoreCalc Online.',
            image: 'https://phishtopia.com/share/storecalc.png',
            imageType: 'image/png',
            imageAlt: 'A calculator and organized commissary order sheet for StoreCalc Online.'
        },
        'archive-page': {
            title: 'Project Archive | Phishtopia',
            description: 'Browse preserved course work, earlier projects, and the experiments that led to Phishtopia.',
            image: 'https://phishtopia.com/share/archive.png',
            imageType: 'image/png',
            imageAlt: 'Layered project folders and a timeline representing preserved Phishtopia experiments and course work.'
        },
        'contact': {
            title: 'Contact Phishtopia',
            description: 'Send questions, report a problem, or share an idea for what Phishtopia should build next.',
            image: 'https://phishtopia.com/share/contact.png',
            imageType: 'image/png',
            imageAlt: 'A glowing message envelope inviting questions, feedback, and new ideas for Phishtopia.'
        },
        'privacy': {
            title: 'Privacy at Phishtopia',
            description: 'Learn what Phishtopia collects, why it is needed, where it goes, and how account deletion works.',
            image: 'https://phishtopia.com/share/privacy.png',
            imageType: 'image/png',
            imageAlt: 'A shield and lock representing Phishtopia privacy practices.'
        }
    }; %>
    <% const sharePage = sharePages[bodyClass] || {}; %>
    <% const description = typeof pageDescription !== 'undefined' ? pageDescription : (sharePage.description || 'Home of the Improbable.'); %>
    <% const socialTitle = sharePage.title || title || 'Phishtopia'; %>
    <% const socialImage = sharePage.image || 'https://phishtopia.com/images/share-card.png'; %>
    <% const socialImageType = sharePage.imageType || 'image/png'; %>
    <% const socialImageAlt = sharePage.imageAlt || 'Phishtopia social card featuring a cyber fish and the words Home of the Improbable.'; %>
    <% if (!analyticsDisabled) { %>
        <!-- Google Tag Manager -->
        <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-MWQ8XZV3');</script>
        <!-- End Google Tag Manager -->
    <% } %>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || "Phishtopia" %></title>
    <meta name="description" content="<%= description %>">
    <meta name="author" content="PhishyOne">
    <meta name="theme-color" content="#05899E">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000">

    <meta property="og:title" content="<%= socialTitle %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= socialImage %>">
    <meta property="og:image:secure_url" content="<%= socialImage %>">
    <meta property="og:image:type" content="<%= socialImageType %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="<%= socialImageAlt %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Phishtopia">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= socialTitle %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= socialImage %>">
    <meta name="twitter:image:alt" content="<%= socialImageAlt %>">
    <meta name="twitter:site" content="@PhishyOne">
    <meta name="twitter:creator" content="@PhishyOne">

    <link rel="canonical" href="<%= canonicalUrl %>">
    <meta name="robots" content="<%= robots %>">
    <link rel="alternate" hreflang="en" href="<%= canonicalUrl %>">

    <link rel="apple-touch-icon" sizes="180x180" href="https://phishtopia.com/images/phishLogo.png">
    <link rel="icon" href="https://phishtopia.com/images/phishLogo.png" type="image/png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Londrina+Shadow&family=Modak&family=Pompiere&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/styles/main.css">
    <link rel="stylesheet" href="/styles/navigation.css">

    <% if (extraStyles) { %>
        <% const styles = Array.isArray(extraStyles) ? extraStyles : [extraStyles]; %>
        <% styles.forEach(src => { %>
            <link rel="stylesheet" href="<%= src %>">
        <% }); %>
    <% } %>
</head>

<body class="<%= bodyClass || '' %>">
    <% if (!analyticsDisabled) { %>
        <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MWQ8XZV3"
            height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <% } %>

    <canvas id="bubble-canvas"></canvas>

    <nav class="main-nav" aria-label="Primary navigation">
        <div class="nav-left">
            <a href="/" aria-label="Phishtopia home">
                <img src="/images/phishLogo.png" alt="Phishtopia" class="logo">
            </a>

            <ul class="nav-links desktop-primary-links">
                <li class="nav-item"><a class="nav-link" href="/youlist">YouList</a></li>
                <li class="nav-item"><a class="nav-link" href="/echotrace">EchoTrace</a></li>
                <li class="nav-item"><a class="nav-link" href="/storecalc">StoreCalc</a></li>
                <li class="nav-item"><a class="nav-link" href="/archive">Archive</a></li>
                <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
            </ul>
        </div>

        <ul class="nav-right nav-links desktop-account-links">
            <% if (user) { %>
                <li class="nav-item"><a id="username" class="nav-link" href="/dashboard">Hi, <%= user.username %></a></li>
                <li class="nav-item">
                    <form action="/auth/logout" method="POST">
                        <button type="submit" class="btn logout-btn">Logout</button>
                    </form>
                </li>
            <% } else { %>
                <li class="nav-item">
                    <a class="login-register" href="/auth/login?returnTo=<%= encodeURIComponent(currentUrl || '/') %>">Login</a>
                </li>
                <li class="nav-item"><a class="login-register" href="/auth/register">Register</a></li>
            <% } %>
        </ul>

        <div class="mobile-nav-actions">
            <% if (user) { %>
                <a
                    class="mobile-dashboard-link"
                    href="/dashboard"
                    aria-label="Open dashboard for <%= user.username %>"
                ><%= user.username %></a>
            <% } %>

            <details class="mobile-nav-menu">
                <summary aria-label="Open navigation menu">
                    <span aria-hidden="true" class="mobile-menu-icon"></span>
                    <span>Menu</span>
                </summary>

                <ul class="mobile-nav-links">
                    <li class="mobile-nav-section-label" aria-hidden="true">Projects</li>
                    <li class="mobile-project-item"><a class="mobile-project-link" href="/storecalc">StoreCalc</a></li>
                    <li class="mobile-project-item"><a class="mobile-project-link" href="/echotrace">EchoTrace</a></li>
                    <li class="mobile-project-item"><a class="mobile-project-link" href="/youlist">YouList</a></li>

                    <li class="mobile-nav-section-label" aria-hidden="true">Site</li>
                    <li><a href="/archive">Archive</a></li>
                    <li><a href="/contact">Contact</a></li>
                    <li><a href="/privacy">Privacy</a></li>

                    <li class="mobile-nav-section-label" aria-hidden="true">Account</li>
                    <% if (user) { %>
                        <li><a href="/dashboard">Dashboard</a></li>
                        <li><a href="/account">Account settings</a></li>
                        <li class="mobile-logout-item">
                            <form action="/auth/logout" method="POST">
                                <button type="submit">Logout</button>
                            </form>
                        </li>
                    <% } else { %>
                        <li class="mobile-auth-item"><a href="/auth/login?returnTo=<%= encodeURIComponent(currentUrl || '/') %>">Login</a></li>
                        <li class="mobile-auth-item"><a href="/auth/register">Register</a></li>
                    <% } %>
                </ul>
            </details>
        </div>
    </nav>
