<%- include('partials/header.ejs') %>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://phishtopia.com/#website",
    "url": "https://phishtopia.com/",
    "name": "Phishtopia",
    "alternateName": "Phishtopia.com",
    "description": "<%= pageDescription %>",
    "inLanguage": "en"
}
</script>

<main class="main-grid">
    <section class="hero-section">
        <h1 class="gradient-text">Phishtopia.com</h1>
        <p class="hero-tagline"><strong>Home of the Improbable.</strong></p>
        <p class="hero-description"><%= pageDescription %></p>
    </section>

    <section class="projects-section">
        <h2>YouList</h2>
        <p>Search for movies and television shows, then add comments to a shared community list.</p>
        <a href="/youlist" class="btn">Open YouList</a>
    </section>

    <section class="new-section">
        <h2>EchoTrace</h2>
        <p>Analyze publicly available EVE Echoes killmail data to identify player activity patterns.</p>
        <a href="/echotrace" class="btn">Open EchoTrace</a>
    </section>

    <section class="projects-section">
        <h2>StoreCalc</h2>
        <p>A commissary-order calculator is planned after the current cleanup and stabilization work.</p>
        <a href="/storecalc" class="btn">View StoreCalc</a>
    </section>
</main>

<%- include('partials/footer.ejs') %>
